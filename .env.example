# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mind_db
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/mind_db

# Agent
CONVERSATION_WINDOW=20
AGENT_MAX_TOOL_CYCLES=5

# Reports
CLIENT_NAME=Versat
CLIENT_LOGO_PATH=

# Consumo de tokens / alertas
USAGE_DEFAULT_THRESHOLD_USD=8
USAGE_DEFAULT_PERIOD=month

# Email opcional para alertas de consumo (si se deja vacío se usa solo Telegram)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Server
PORT=8000
